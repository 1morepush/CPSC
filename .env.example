# HuggingFace (free) - AI-powered insights
# Get a free token at https://huggingface.co/settings/tokens
# Without this, insights use built-in templates instead
HF_TOKEN=

# Reddit API (optional — covers 8 subreddits: worldnews, gaming, technology, etc.)
# Register a free "script" app at https://www.reddit.com/prefs/apps
# Use http://localhost:8080 as the redirect URI (never actually called)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InternetMoodTracker/1.0

# Mastodon (optional — covers FinTwit, MusicTwitter, TechTwitter communities)
# No account needed — uses public tag timelines. Default: mastodon.social
MASTODON_INSTANCE=mastodon.social

# News API (optional — covers worldnews, newsheadlines, politics)
# Free tier at https://newsapi.org (100 requests/day)
NEWS_API_KEY=

# YouTube API (optional)
YOUTUBE_API_KEY=

# Backend config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Demo mode
# true  = fully simulated data, no API keys needed (default)
# false = real scrapers run alongside simulation:
#         - Hacker News: always on, no key required
#         - NewsAPI:     runs if NEWS_API_KEY is set
#         - Reddit:      runs if REDDIT_CLIENT_ID + SECRET are set
#         - Mastodon:    always on, no key required
USE_DEMO_MODE=true
