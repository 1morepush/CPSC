# Reddit API (optional - enables live Reddit data)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=InternetMoodTracker/1.0

# News API (optional - enables live news headlines)
NEWS_API_KEY=

# YouTube API (optional)
YOUTUBE_API_KEY=

# Backend config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Demo mode (true = use simulated data, false = try real APIs)
USE_DEMO_MODE=true
